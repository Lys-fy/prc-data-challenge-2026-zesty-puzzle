# KUMO_CLUSTER_SETUP cluster settings: fill the placeholders after reading the cluster's documentation / usage policy (docs/kumo_gpu.md, Running step 2).
export SBATCH_PARTITION="__PARTITION__"          # e.g. gpu, a100, h100
export SBATCH_ACCOUNT="__ACCOUNT__"              # project / allocation id given with the access
export GPU_GRES="gpu:__GPUTYPE__:1"              # e.g. gpu:a100:1, gpu:h100:1 (m50e8/l50*: an 80 GB card; l50e16: H200 safest) (some sites: --gpus=1 + --constraint=h100; then edit GPU_OPTS)
export GPU_OPTS="--gres=$GPU_GRES"
export QOS_OPTS=""                               # e.g. "--qos=normal" if required
export BUNDLE="${BUNDLE:-$PWD}"   # where this folder lives on the cluster (shared FS)
export PAYLOAD="${PAYLOAD:-$BUNDLE/data/payload}"   # staged data (stage/stage_data.py output, copied into the bundle)
export RUN="${SCRATCH:-$PWD}/run"      # outputs (results/, logs/): fast shared scratch if the site has one
export ENVDIR="$BUNDLE/.venv-kumo"                  # from env/setup_env.sh
export HF_HOME="$PAYLOAD/vendor/hf" HF_HUB_OFFLINE=1
export MAX_PAR=8                                 # array throttle: at most this many GPUs at once (%MAX_PAR) -- respect the fair-share rules
export PROFILE="${PROFILE:-m20e8}"              # arm-M profile: m20e8 (primary) | m50e8 | l50e16 | l50e8 | shared20k (kumo_gpu/acceptance/sb_profiles.txt)
export SYNTH="${SYNTH:-0}"                       # distillation: fraction of synthetic query rows per unit (0 = off; 0.2 = +20 % rows)
# per array task; the largest unit is LTFM prod (47.6k query rows): est. H100 / A100 minutes m20e8 4 / 11, m50e8 7 / 18, l50e16 28 / 70
case $PROFILE in l50e16|l50e8) TM="03:00:00";; m50e8) TM="01:30:00";; *) TM="01:00:00";; esac
export TIME_MEMBER="${TIME_MEMBER:-$TM}" TIME_T2X="00:30:00" TIME_SMOKE="01:00:00" TIME_FT="04:00:00"
export MEM="48G" CPUS=4
