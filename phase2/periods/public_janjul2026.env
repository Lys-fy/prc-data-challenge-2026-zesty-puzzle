# Public leaderboard ranking file (Jan + Jul 2026, 344,841 departures), same recipe as final.env.
# MODE=new: features, side tables and every member are rebuilt for 2025 + these ranking rows; the 2025 fold sides (A side) are linked read-only.
# Form: FORM=v99 line (phase2/run_pipeline.sh) + the v100 -> v111 levers (phase2/steps/p2_v107.sh, KCATLg at the v102 step) + the join-rule
# regime call at LIRF. Flags = the submitted recipe (WIDELEAF PSEUDOLABEL E1S F13 F4 on), default seed bag (line A of final.env).
PERIOD=public_janjul2026
WS_NAME=public_janjul2026
MODE=new
RAW_RANK=$REPO/data/raw/ranking.parquet
NRANK=344841
PRU=1
ADSB=1
FORM=v99
NEWSTAND_DELTA=0
WIDELEAF=1
PSEUDOLABEL=1
E1S=1
F13=1
F4=1
FOLD_LINK=1
POSTRULES_PARAMS=params/postrules_fixed.json
NT=6
NT_V87=4
NT_V107=4
V102ARM=kcatlg_stack
