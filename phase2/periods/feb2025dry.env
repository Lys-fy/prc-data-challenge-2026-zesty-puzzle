# Phase-2 DRY RUN: a synthetic new period = the February 2025 departures, labels removed (steps/p2_mkdry.py), everything rebuilt
# in the workspace: per-batch side tables, q, every member family retrained on 2025 minus February (seed 0; other seeds aliased),
# stage fits on the 2025 fold OOF with the February rows removed, the full chain, post rules and unmatched rules; scored afterwards
# against the held-out labels (phase2/heldout/, unreadable to the pipeline).
PERIOD=feb2025dry
MODE=new
DRY_ARGS="--year 2025 --months 2 --fold months28"
SCORE_ARGS="--fold months28"
FEATURES=${P2_REPO:-$REPO}/phase2/work/feb2025dry/data/features_dry.parquet
NRANK=143732
PRU=1
ADSB=1
MSEEDS=0
DRY_SKIP=V25Lb
NT=6
REF=
